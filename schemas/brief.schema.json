{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vibemotion/brief",
  "title": "Brief",
  "description": "对原始输入内容的拆解理解结果(步骤①②前半)。由 agent 阅读 00_input 原始素材后产出。",
  "type": "object",
  "required": ["source", "title", "summary", "keyPoints"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["url", "video", "code", "article", "idea", "script"],
          "description": "输入类型:链接/视频/产品代码/文章/一句话想法/脚本"
        },
        "ref": { "type": "string", "description": "原始来源(URL、文件路径或原文)" },
        "ingestedAt": { "type": "string" },
        "rawRef": { "type": "string", "description": "指向 00_input/ 下抓取到的原始内容文件" }
      }
    },
    "title": { "type": "string", "description": "内容标题/主题" },
    "summary": { "type": "string", "description": "一两句话的核心要义" },
    "keyPoints": {
      "type": "array",
      "minItems": 1,
      "description": "原始内容的重点信息",
      "items": {
        "type": "object",
        "required": ["point"],
        "additionalProperties": false,
        "properties": {
          "point": { "type": "string", "description": "重点(一句话)" },
          "detail": { "type": "string", "description": "展开说明" },
          "evidence": { "type": "string", "description": "出处/证据/数据支撑" }
        }
      }
    },
    "valueProps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "卖点(产品类内容)"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      },
      "description": "可视化用的数据点"
    },
    "audience": { "type": "string", "description": "推断的目标受众" },
    "language": { "type": "string", "description": "原始内容主语言,如 zh-CN" }
  }
}
